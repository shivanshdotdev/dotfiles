}

sop(){ 
    file="$(find)"
    [ -n "$file" ] && okular "$file"
}

cdJ() {
    local dir
    dir=$(fd -t d -H | fzf) || return
    cd "$dir"
    clear
    ls
}

cdj() {
    local dir
    dir=$(fd -t d | fzf) || return
    cd "$dir"
    ls
}

animated_wallpaper(){
    xwinwrap -fs -fdt -ni -b -nf -ov -- mpv -wid WID --loop --no-audio $1
}


cc() {
    local file="$1"
    local output="${file%.c}.out"

    gcc "$file" -o "./bin/$output" && "./bin/$output"
}

cpc() {
    local file="$1"

    if [[ -z "$file" ]]; then
        file=$(
            fd -e cpp -t f -x stat --printf '%Y\t%n\n' |
            sort -nr |
            cut -f2- |
            fzf --height 100% --reverse
        ) || return
    fi

    local output="${file%.cpp}.out"

    g++ "$file" -o "./bin/$output" && "./bin/$output"
}


jc() {
    local file="$1"

    if [[ -z "$file" ]]; then
        file=$(
            fd -e java -t f -x stat --printf '%Y\t%n\n' |
            sort -nr |
            cut -f2- |
            fzf --height 100% --reverse
        ) || return
    fi

    local output="${file##*/}"
    output="${output%.java}"

    mkdir -p bin

    javac -d bin "$file" && java -cp bin "$output"
}
